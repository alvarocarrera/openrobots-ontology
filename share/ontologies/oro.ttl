@prefix : <http://kb.openrobots.org#> .
@prefix concept: <http://sw.opencyc.org/concept/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ex: <http://example.org/> .
@prefix onyx: <http://www.gsi.upm.es/ontologies/onyx/ns#> .
@prefix oro: <http://kb.openrobots.org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://kb.openrobots.org#> .

<http://kb.openrobots.org> rdf:type owl:Ontology ;
                            dc:creator "CNRS-LAAS" ,
                                       "PAL Robotics" ,
                                       "GSI-UPM" ;
                            dc:date "2022-03-30" ;
                            dc:rights "Creative Commons 3.0 by" ;
                            dc:title "OpenRobots Ontology - Common Sense"@en ;
                            rdfs:comment """This ontology is a part of the OpenRobots Ontology (ORO) project.
It covers the \"common sense\" knowledge and rules, independantly of robotic application (however, only a small subset of common sense, relevant for robotic use cases, is represented)."""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://kb.openrobots.org#interrogative
oro:interrogative rdf:type owl:AnnotationProperty .


###  http://kb.openrobots.org#openCycUri
oro:openCycUri rdf:type owl:AnnotationProperty .


###  http://kb.openrobots.org#question
oro:question rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/rights
dc:rights rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://kb.openrobots.org#actionInvolves
oro:actionInvolves rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf oro:involves ;
                   rdfs:domain concept:Action .


###  http://kb.openrobots.org#actsOnObject
oro:actsOnObject rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf oro:hasThematicRoleRelationWith ;
                 rdfs:domain concept:PurposefulAction ;
                 rdfs:range concept:PartiallyTangible ;
                 rdfs:comment """Theme (or Patient) of an action: Entity undergoing the effect of some action

Example: >Mary< fell over.""" ;
                 rdfs:label "acts on"@en ,
                            "agit sur"@fr .


###  http://kb.openrobots.org#after
oro:after rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf oro:after-Underspecified ;
          rdfs:domain oro:TimePoint ;
          rdfs:range oro:TimePoint .


###  http://kb.openrobots.org#after-Underspecified
oro:after-Underspecified rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf oro:temporallyRelated .


###  http://kb.openrobots.org#agentRelativeProperty
oro:agentRelativeProperty rdf:type owl:ObjectProperty ;
                          rdfs:comment "An \"agent relative property\" is always relative to the point of view of the agent \"myself\""@en .


###  http://kb.openrobots.org#behind
oro:behind rdf:type owl:ObjectProperty ;
           owl:equivalentProperty concept:behind-Generally ;
           rdfs:subPropertyOf oro:hasRelativePosition ;
           owl:inverseOf oro:inFrontOf ;
           rdf:type owl:TransitiveProperty ;
           rdfs:label "is behind" .


###  http://kb.openrobots.org#belongsTo
oro:belongsTo rdf:type owl:ObjectProperty ;
              rdfs:domain oro:Artifact ;
              rdfs:range oro:Agent ;
              rdfs:label "appartient à"@fr ,
                         "belongs to"@en .


###  http://kb.openrobots.org#bringsToStaticSituation
oro:bringsToStaticSituation rdf:type owl:ObjectProperty ;
                            rdfs:domain concept:Action ;
                            rdfs:range concept:StaticSituation ;
                            rdfs:label "leads to the static situation" .


###  http://kb.openrobots.org#canBePerformedBy
oro:canBePerformedBy rdf:type owl:ObjectProperty ;
                     owl:inverseOf oro:canPerform ;
                     rdfs:label "can be performed by" .


###  http://kb.openrobots.org#canPerform
oro:canPerform rdf:type owl:ObjectProperty ;
               rdfs:domain oro:Agent ;
               rdfs:range concept:PurposefulAction .


###  http://kb.openrobots.org#canUndertakeNow
oro:canUndertakeNow rdf:type owl:ObjectProperty ;
                    rdfs:domain oro:Agent ;
                    rdfs:range concept:PurposefulAction ;
                    rdfs:comment "Links an agent to an action it can starts now. When required, this relationship is to be computed by a planner (or inferred from a model of the human)." ;
                    rdfs:label "can undertake now" .


###  http://kb.openrobots.org#contains
oro:contains rdf:type owl:ObjectProperty ;
             owl:inverseOf oro:isContainedIn ;
             rdfs:domain oro:Container ;
             rdfs:comment "Links a (physical) container to its (physical) content."@en .


###  http://kb.openrobots.org#currentlyBodilyDoes
oro:currentlyBodilyDoes rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf oro:currentlyDoes ;
                        rdfs:domain oro:EmbodiedAgent ;
                        rdfs:comment "(currentlyBodilyDoes AGENT ACTION) means that the (embodied) AGENT is currently performing a non-intentional action ACTION." .


###  http://kb.openrobots.org#currentlyDoes
oro:currentlyDoes rdf:type owl:ObjectProperty ;
                  owl:inverseOf oro:currentlyDoneBy .


###  http://kb.openrobots.org#currentlyDoneBy
oro:currentlyDoneBy rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf concept:doneBy ;
                    rdfs:comment "Denotes that the DOES of the EVENT is currently doing it. It's a temporaly bound version of doneBy."@en .


###  http://kb.openrobots.org#currentlyPerforms
oro:currentlyPerforms rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf oro:currentlyDoes ;
                      rdfs:domain oro:Agent ;
                      rdfs:range concept:Action ;
                      rdfs:comment "(currentlyPerforms AGENT ACTION) means that the AGENT is currently performing the intentional ACTION." ;
                      rdfs:label "currently performs" ;
                      rdfs:seeAlso """performedBy is the non-temporaly bound inverse property.

currentlyBodilyDo is another specialization of currentlyDo, for non intentional actions."""@en .


###  http://kb.openrobots.org#desires
oro:desires rdf:type owl:ObjectProperty ;
            rdfs:domain oro:Agent ;
            rdfs:range concept:Situation ;
            rdfs:label "desire"@en ,
                       "desires"@en .


###  http://kb.openrobots.org#duration
oro:duration rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf oro:temporallyRelated ;
             rdfs:domain concept:TemporalThing ;
             rdfs:range oro:TimeInterval ;
             rdfs:label "lasts" .


###  http://kb.openrobots.org#endingPoint
oro:endingPoint rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf oro:temporallyRelated ;
                rdfs:domain concept:Plan-ExpectedSituationType ;
                rdfs:range oro:TimePoint .


###  http://kb.openrobots.org#experiences
oro:experiences rdf:type owl:ObjectProperty ;
                owl:inverseOf oro:isExperienced ;
                rdfs:domain oro:Agent ;
                rdfs:range concept:StaticSituation ;
                rdfs:comment "describes a agent that currently *is* in a specific (static) situation"@en ;
                rdfs:label "experiences"@en ,
                           "vit"@fr .


###  http://kb.openrobots.org#focusesOn
oro:focusesOn rdf:type owl:ObjectProperty ;
              owl:inverseOf oro:isFocusOf ;
              rdfs:domain oro:Agent ;
              rdfs:range concept:EnduringThing-Localized ;
              rdfs:comment "An agent is said to focus on an object if and only if it looksAt it AND pointsAt it."@en ;
              rdfs:label "focuses on" .


###  http://kb.openrobots.org#hasBodyPart
oro:hasBodyPart rdf:type owl:ObjectProperty ;
                rdfs:domain oro:Agent ;
                rdfs:range oro:BodyPart .


###  http://kb.openrobots.org#hasCharacteristicLocation
oro:hasCharacteristicLocation rdf:type owl:ObjectProperty ;
                              rdfs:range oro:Location ;
                              rdfs:comment "the typical, expected 'default' location of something"@en .


###  http://kb.openrobots.org#hasColor
oro:hasColor rdf:type owl:ObjectProperty ;
             owl:equivalentProperty oro:mainColorOfObject ;
             rdfs:subPropertyOf oro:hasFeature ;
             rdf:type owl:FunctionalProperty ;
             rdfs:range concept:Color ;
             oro:question "What is the color?"@en ;
             rdfs:comment "describe the main, significant color of the object." .


###  http://kb.openrobots.org#hasEngagementLevel
oro:hasEngagementLevel rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain oro:EngagementSituation ;
                       rdfs:range oro:EngagementLevel ;
                       rdfs:comment "the current 'level' of engagement of an EngagementSituation"@en .


###  http://kb.openrobots.org#hasFeature
oro:hasFeature rdf:type owl:ObjectProperty .


###  http://kb.openrobots.org#hasGoal
oro:hasGoal rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf oro:hasThematicRoleRelationWith ;
            rdfs:comment """Goal: Entity towards which something moves.

Example: John went >home<""" ;
            rdfs:label "aims to"@en ,
                       "vise à"@fr .


###  http://kb.openrobots.org#hasInHand
oro:hasInHand rdf:type owl:ObjectProperty ;
              rdfs:domain oro:Agent ;
              rdfs:range oro:GraspableObject .


###  http://kb.openrobots.org#hasInLeftHand
oro:hasInLeftHand rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf oro:hasInHand ;
                  rdf:type owl:FunctionalProperty .


###  http://kb.openrobots.org#hasInRightHand
oro:hasInRightHand rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf oro:hasInHand ;
                   rdf:type owl:FunctionalProperty .


###  http://kb.openrobots.org#hasPosture
oro:hasPosture rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain oro:Agent ;
               rdfs:range oro:Posture .


###  http://kb.openrobots.org#hasRelativePosition
oro:hasRelativePosition rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf oro:agentRelativeProperty ;
                        rdfs:domain oro:Location ;
                        rdfs:range oro:Location ;
                        rdfs:label "has relative position" .


###  http://kb.openrobots.org#hasShape
oro:hasShape rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf oro:hasFeature ;
             rdf:type owl:FunctionalProperty ;
             rdfs:range oro:Shape .


###  http://kb.openrobots.org#hasSize
oro:hasSize rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf oro:hasFeature ;
            rdf:type owl:FunctionalProperty .


###  http://kb.openrobots.org#hasThematicRoleRelationWith
oro:hasThematicRoleRelationWith rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf owl:topObjectProperty ;
                                rdfs:label "a une relation thématique avec"@fr ,
                                           "has a role relation with" .


###  http://kb.openrobots.org#holds
oro:holds rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf concept:holds-Underspecified ;
          rdfs:range concept:PartiallyTangible .


###  http://kb.openrobots.org#inFrontOf
oro:inFrontOf rdf:type owl:ObjectProperty ;
              owl:equivalentProperty concept:inFrontOf-Generally ;
              rdfs:subPropertyOf oro:hasRelativePosition ;
              rdf:type owl:TransitiveProperty ;
              rdfs:label "is in front of" .


###  http://kb.openrobots.org#involves
oro:involves rdf:type owl:ObjectProperty ;
             rdfs:domain concept:Situation ;
             rdfs:range owl:Thing ;
             rdfs:label "implique"@fr ,
                        "involves"@en .


###  http://kb.openrobots.org#isAbleTo
oro:isAbleTo rdf:type owl:ObjectProperty ;
             rdfs:domain oro:Agent ;
             rdfs:range concept:PurposefulAction ;
             rdfs:comment "(isAbleTo AGENT ACTION) says that AGENT it technically/physically able to achieve the ACTION. It does not mean that the agent can do it right now (see canUndertakeNow for this meaning). The ACTION is constrainted to purposeful actions: isAbleTo does not intend to express a fact like \"a stone is able to sink into the water\"." ;
             rdfs:label "am able to"@en ,
                        "are able to"@en ,
                        "can"@en ,
                        "is able to"@en .


###  http://kb.openrobots.org#isAbove
oro:isAbove rdf:type owl:ObjectProperty ;
            owl:equivalentProperty concept:above-Generally ;
            owl:inverseOf oro:isBelow .


###  http://kb.openrobots.org#isAt
oro:isAt rdf:type owl:ObjectProperty ;
         owl:equivalentProperty concept:objectFoundInLocation ;
         owl:inverseOf oro:placeOf ;
         rdfs:domain oro:Location ;
         rdfs:range oro:Location ;
         rdfs:label "am at"@en ,
                    "are at"@en ,
                    "is at"@en .


###  http://kb.openrobots.org#isBelow
oro:isBelow rdf:type owl:ObjectProperty ;
            rdfs:domain oro:Location ;
            rdfs:range oro:Location ;
            rdfs:label "est sous"@fr ,
                       "is under"@en .


###  http://kb.openrobots.org#isContainedIn
oro:isContainedIn rdf:type owl:ObjectProperty .


###  http://kb.openrobots.org#isExperienced
oro:isExperienced rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf oro:staticSituationInvolves .


###  http://kb.openrobots.org#isFocusOf
oro:isFocusOf rdf:type owl:ObjectProperty ;
              rdfs:label "is in the focus of" .


###  http://kb.openrobots.org#isIn
oro:isIn rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf oro:isAt ;
         rdfs:label "am in"@en ,
                    "are in"@en ,
                    "est dans"@fr ,
                    "is in"@en .


###  http://kb.openrobots.org#isLocated
oro:isLocated rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:comment """describe the symbolic position on an object relative to 'myself'.
Values can be:
{NEAR_FAR}_{FRONT LEFT RIGHT BACK}""" ;
              rdfs:label "has relative location" .


###  http://kb.openrobots.org#isNextTo
oro:isNextTo rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:label "am next to"@en ,
                        "are next to"@en ,
                        "is next to"@en .


###  http://kb.openrobots.org#isOn
oro:isOn rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf oro:isAt ;
         rdfs:label "est sur"@fr ,
                    "is on"@en .


###  http://kb.openrobots.org#isSharedSituation
oro:isSharedSituation rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ;
                      rdfs:domain concept:Situation ;
                      rdfs:range concept:Situation .


###  http://kb.openrobots.org#jointEngagementWith
oro:jointEngagementWith rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf oro:isSharedSituation ;
                        rdf:type owl:SymmetricProperty ;
                        rdfs:domain oro:EngagementSituation ;
                        rdfs:range oro:EngagementSituation ;
                        rdfs:comment """describes that two situations experiences by two agents are in fact mutual engagement (ie, the two situations are EngagementSituations, and the two agents are engaged together).

?a experiences ?s1, ?b experiences ?s2, ?s1 jointEngagementWith ?s2 implies that ?s1 and ?s2 are engagement situations experienced by ?a and ?b, and ?a and ?b are in fact engaged together."""@en .


###  http://kb.openrobots.org#leftOf
oro:leftOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf oro:hasRelativePosition ;
           owl:inverseOf oro:rightOf ;
           rdf:type owl:TransitiveProperty ;
           rdfs:label "is left of" .


###  http://kb.openrobots.org#looksAt
oro:looksAt rdf:type owl:ObjectProperty ;
            rdfs:domain oro:Agent ;
            rdfs:range concept:EnduringThing-Localized ;
            rdfs:comment "Describes the status of an agent actively looking at an object ('sees' doesn't imply the agent is actively looking at the object, but only that the object is in the field of view of the agent)."@en ;
            rdfs:label "looks at"@en ,
                       "regarde"@fr .


###  http://kb.openrobots.org#mainColorOfObject
oro:mainColorOfObject rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      oro:interrogative "What is the color?"@en ;
                      oro:openCycUri "http://sw.opencyc.org/concept/Mx4r45WD6H7_EdaAAAABAjVgzA" ;
                      rdfs:label "has main color" .


###  http://kb.openrobots.org#objectOfAction
oro:objectOfAction rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf oro:actionInvolves ;
                   rdfs:range owl:Thing ;
                   rdfs:comment """Binds an action to one or several objects which are targetted by the action.
For instance, in the assertion, \"I take a cup\", \"cup\" is the ObjectOfAction of \"to take\".

In the sentence \"Jido shows the Eiffel tower to the tourist\", the object of action is the Eiffel tower and the receiver is the tourist, as specified by the \"receiverOfAction\" property.""" .


###  http://kb.openrobots.org#placeOf
oro:placeOf rdf:type owl:ObjectProperty .


###  http://kb.openrobots.org#pointsAt
oro:pointsAt rdf:type owl:ObjectProperty ;
             owl:equivalentProperty concept:pointingToward ;
             rdfs:domain oro:Agent ;
             rdfs:range concept:EnduringThing-Localized ;
             rdfs:comment "Describes the status of an agent physically pointing at a physical location with a hand."@en ;
             rdfs:label "points at" .


###  http://kb.openrobots.org#purposeOfAction
oro:purposeOfAction rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf oro:actionInvolves ;
                    rdfs:range concept:Situation ;
                    rdfs:comment "binds an action to a state of the world (a Situation) which is desired as a result (at short or long term) of this action." .


###  http://kb.openrobots.org#reaches
oro:reaches rdf:type owl:ObjectProperty ;
            rdfs:comment """This property represent the \"active form\" of the \"isReachable\" predicate.
?o isReachable true <=> myself reaches ?o

It is meant to be only use through rule inference, and is added to this \"ROMAN\" scenario specific ontology to ensure fluid interaction with the Natural Language module.""" .


###  http://kb.openrobots.org#receivedBy
oro:receivedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf oro:hasThematicRoleRelationWith ;
               rdfs:domain concept:PurposefulAction ;
               rdfs:range concept:SpatialThing-Localized ;
               rdfs:comment """Link an action to the object or agent that is a recipient of the action result.
Not to be confused with actionOnObject that denote that the object is the main concern of the action.

Example: John got >Mary< a present.""" ;
               rdfs:label "received by"@en ,
                          "reçu par"@fr .


###  http://kb.openrobots.org#recipientOfAction
oro:recipientOfAction rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf oro:actionInvolves ;
                      rdfs:range concept:PartiallyTangible ;
                      rdfs:comment """When relevant for the considered action, this property specify the agent or object whose state is eventually modified as a *result* of an action. It is not be the object of action itself (specified by the \"objectOfAction\" property).

For instance, in the sentence \"The robot gives the cup to the human\", the human is the final recipient of the cup and hence the recipientOfAction. In the sentence \"I place the robot on the chair\", the chair is the recipient of action while the robot is the object of the action. In the sentence \"Jido shows the Eiffel tower to the tourist\", the recipient is the tourist and the object of action is the Eiffel tower.""" .


###  http://kb.openrobots.org#rightOf
oro:rightOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf oro:hasRelativePosition ;
            rdf:type owl:TransitiveProperty ;
            rdfs:label "is right of" .


###  http://kb.openrobots.org#sees
oro:sees rdf:type owl:ObjectProperty ;
         rdfs:domain oro:Agent ;
         rdfs:range concept:EnduringThing-Localized ;
         rdfs:label "see"@en ,
                    "sees"@en ,
                    "voit"@fr .


###  http://kb.openrobots.org#startingPoint
oro:startingPoint rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf oro:temporallyRelated ;
                  rdfs:domain concept:Plan-ExpectedSituationType ;
                  rdfs:range oro:TimePoint .


###  http://kb.openrobots.org#startsAfterEndingOf
oro:startsAfterEndingOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf oro:after-Underspecified ;
                        rdfs:domain concept:TemporalThing ;
                        rdfs:range concept:TemporalThing ;
                        rdfs:comment "A ComplexTemporalPredicate (q.v.) that relates any pair of temporal things such that the first starts after the second ends. (startsAfterEndingOf AFTER BEFORE) means that the time point (see TimePoint) at which AFTER first starts to exist or occur is temporally later than (see after) the time point at which BEFORE finally ceases to exist or occur. Thus it is equivalent to the form (after (StartFn AFTER) (EndFn BEFORE)). That is, the startingPoint of AFTER is later than the endingPoint of BEFORE."@en .


###  http://kb.openrobots.org#staticSituationInvolves
oro:staticSituationInvolves rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf oro:involves ;
                            rdfs:domain concept:StaticSituation ;
                            rdfs:range oro:Agent ;
                            rdfs:comment "Binds a static situation (a state of the world) to the agents involved in the situation." .


###  http://kb.openrobots.org#taskOfPlan
oro:taskOfPlan rdf:type owl:ObjectProperty ;
               rdfs:domain oro:Task ;
               rdfs:range oro:TaskPlan ;
               rdfs:label "is a task of plan" .


###  http://kb.openrobots.org#temporallyRelated
oro:temporallyRelated rdf:type owl:ObjectProperty .


###  http://sw.opencyc.org/concept/above-Generally
concept:above-Generally rdf:type owl:ObjectProperty .


###  http://sw.opencyc.org/concept/above_Touching
concept:above_Touching rdf:type owl:ObjectProperty .


###  http://sw.opencyc.org/concept/behind-Generally
concept:behind-Generally rdf:type owl:ObjectProperty .


###  http://sw.opencyc.org/concept/bodilyDoer
concept:bodilyDoer rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf concept:doneBy ;
                   rdfs:comment "The predicate bodilyDoer relates a given physical event to any organism that is a non-deliberate \"doer\" of the event (i.e. the organism acts without conscious intention or volition)."@en .


###  http://sw.opencyc.org/concept/doneBy
concept:doneBy rdf:type owl:ObjectProperty ;
               rdfs:domain concept:Event ;
               rdfs:comment "A very general predicate that relates events to the things that \"do\" them. (doneBy EVENT DOER) means that DOER is a \"doer\" in the event EVENT: some activity on the part of DOER causes or carries out EVENT. This predicate is agnostic as to whether DOER does EVENT intentionally or not. Note that DOER need not even be animate or an agent; e.g. the famous vocanic eruption that buried Pompeii was doneBy Mt. Vesuvius. Note also that an event might have more than one doer; consider a chess game."@en .


###  http://sw.opencyc.org/concept/farFrom
concept:farFrom rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain oro:Location ;
                owl:propertyDisjointWith concept:near ;
                rdfs:label "is far from" .


###  http://sw.opencyc.org/concept/holds-Underspecified
concept:holds-Underspecified rdf:type owl:ObjectProperty ;
                             rdfs:domain owl:Thing ;
                             rdfs:range owl:Thing ;
                             oro:openCycUri "http://sw.opencyc.org/concept/Mx4rWdwvdL9_EdaAAAACs6MxSQ" .


###  http://sw.opencyc.org/concept/inFrontOf-Generally
concept:inFrontOf-Generally rdf:type owl:ObjectProperty .


###  http://sw.opencyc.org/concept/near
concept:near rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain oro:Location ;
             rdfs:comment "Relates an agent to some object: a \"near\" object is closer than 1m from the agent."@en ;
             rdfs:label "is near of" .


###  http://sw.opencyc.org/concept/objectFoundInLocation
concept:objectFoundInLocation rdf:type owl:ObjectProperty ;
                              oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjQ5JwpEbGdrcN5Y29ycA" ;
                              rdfs:comment "Links a localizable thing to its location." ;
                              rdfs:label "is at" .


###  http://sw.opencyc.org/concept/performedBy
concept:performedBy rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf oro:hasThematicRoleRelationWith ,
                                       concept:doneBy ;
                    rdfs:domain concept:PurposefulAction ;
                    rdfs:range oro:Agent ;
                    rdfs:comment """Instigator of some action.

Example: >John< killed Harry.""" ;
                    rdfs:label "effectué par"@fr ,
                               "performed by"@en .


###  http://sw.opencyc.org/concept/pointingToward
concept:pointingToward rdf:type owl:ObjectProperty .


###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://kb.openrobots.org#canBeManipulated
oro:canBeManipulated rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain concept:PartiallyTangible ;
                     rdfs:range xsd:boolean ;
                     rdfs:comment "Indicates if an object can be manipulated (knows a grasping point for the object) by the agent myself. Thus, if the object can be manipulated, it is movable as well." .


###  http://kb.openrobots.org#hasCharacteristicDimension
oro:hasCharacteristicDimension rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain concept:PartiallyTangible ;
                               rdfs:range xsd:integer ;
                               rdfs:comment "Characteristic entity dimension, in centimeters" .


###  http://kb.openrobots.org#hasCharacteristicWeight
oro:hasCharacteristicWeight rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain concept:PartiallyTangible ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "The characteristic weight of the tangible facet of the object, in grammes" .


###  http://kb.openrobots.org#hasName
oro:hasName rdf:type owl:DatatypeProperty ;
            rdfs:domain oro:Agent ;
            rdfs:range xsd:string ;
            rdfs:comment """The name of the agent. If the agent is known by several name, more than one triple <agent hasName name>.

The preferred name for an agent can be access through the (functional) preferredName predicate."""@en .


###  http://kb.openrobots.org#isDesired
oro:isDesired rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain concept:Situation ;
              rdfs:range xsd:boolean ;
              oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvViA0JwpEbGdrcN5Y29ycA" ;
              rdfs:comment """IsDesired is equivalent to (desires MYSELF PROP). 
(desire AGT PROP) means that the Agent_PartiallyTangible AGT desires that the world be as the proposition PROP (represented by a CycLSentence_Assertible) describes it to be. desires is implied by goals, but is weaker: PROP might be some desirable state of affairs that the agent is not actively working, or planning, to make/keep true; e.g., world peace.""" .


###  http://kb.openrobots.org#isHolder
oro:isHolder rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain concept:PartiallyTangible ;
             rdfs:range xsd:boolean ;
             rdfs:comment """True if one of the object primary function is to hold other objects.
See the temporalProperty holds-Underspecified for a relationship between a holder and a holded object.""" .


###  http://kb.openrobots.org#isInFieldOfView
oro:isInFieldOfView rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:comment "Indicates if an enduring thing-localized is directly (ie, without moving) visible for the agent (myself)." ;
                    rdfs:seeAlso "sees: X isInFieldOfView true <=> myself sees X" .


###  http://kb.openrobots.org#isMovable
oro:isMovable rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain concept:PartiallyTangible ;
              rdfs:range xsd:boolean ;
              rdfs:comment "States if a given artifact is movable by someone (not specifying who)."@en .


###  http://kb.openrobots.org#isMoving
oro:isMoving rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain concept:EnduringThing-Localized ;
             rdfs:range xsd:boolean .


###  http://kb.openrobots.org#isPerceived
oro:isPerceived rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain concept:EnduringThing-Localized ;
                rdfs:range xsd:boolean ;
                rdfs:comment """Indicates if an enduring thing-localized is currently perceived by the agent (myself).

The 'thing' might be perceived by any sense/exteroception system available to the agent, including (but not limited to) sight/vision, touch, sound."""@en .


###  http://kb.openrobots.org#isReachable
oro:isReachable rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain concept:PartiallyTangible ;
                rdfs:range xsd:boolean ;
                rdfs:comment """True if the object is currently reachable by agent myself.
Thus an object can not be said to be generally reachable or not."""@en .


###  http://kb.openrobots.org#isSitting
oro:isSitting rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain oro:Agent ;
              rdfs:range xsd:boolean .


###  http://kb.openrobots.org#isTraversable
oro:isTraversable rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain concept:EnduringThing-Localized ;
                  rdfs:range xsd:boolean .


###  http://kb.openrobots.org#isVisible
oro:isVisible rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain concept:EnduringThing-Localized ;
              rdfs:range xsd:boolean ;
              rdfs:comment """Indicates if an enduring thing-localized is visible (modulo a head movement) for the agent (myself).

This means that the object may not be currently in the field of view of the agent, but only requires the agent to turn the head to see it.""" .


###  http://kb.openrobots.org#preferredName
oro:preferredName rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf oro:hasName ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain oro:Agent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Preferred name of an agent. If the agent has other names, the can be access via hasName."@en .


###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://kb.openrobots.org#ActiveConcept
oro:ActiveConcept rdf:type owl:Class ;
                  rdfs:comment """An \"active concept\" is a concept (class or instance) which is considered by the robot to be active at a given time.

\"Active\" may have several meaning, like \"relevant in the current context\" or \"recently accessed\".""" .


###  http://kb.openrobots.org#Agent
oro:Agent rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:unionOf ( oro:Avatar
                                              oro:Human
                                              oro:Robot
                                            )
                              ] ;
          rdfs:subClassOf concept:SolidTangibleThing ;
          owl:disjointWith oro:BodyPart ;
          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvViAB5wpEbGdrcN5Y29ycA" ;
          rdfs:comment "Groups embodied agents (humans and robots) and disembodied ones (avatars)"@en ;
          rdfs:label "agent"@en ,
                     "agent"@fr .


###  http://kb.openrobots.org#Artifact
oro:Artifact rdf:type owl:Class ;
             rdfs:subClassOf concept:PartiallyTangible ;
             oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVkH_ZwpEbGdrcN5Y29ycA" ;
             rdfs:comment "A specialization of InanimateObject. Each instance of Artifact is an at least partially tangible thing which was intentionally created by an Agent_PartiallyTangible (or a group of Agent_PartiallyTangibles working together) to serve some purpose or perform some function. In order to create an instance of Artifact, it is not necessary that an Agent_PartiallyTangible create the matter out of which the Artifact is composed; rather, an Agent_PartiallyTangible can create an instance of Artifact by assembling or modifying existing matter. Examples of Artifacts include a wooden flute that's been whittled from a tree branch, a sawhorse that's been put together out of boards and nails, and a coin that's been minted by embossing or by melting liquid silver into a mold. In addition to the obvious human artifacts (buildings, tools, textiles, power lines), the collection Artifact also includes certain sorts of things made by Animals, such as bird nests, termite mounds, and beaver dams. Artifacts without any tangible parts are excluded from the collection Artifact; they are included in the collection Artifact_Intangible." ;
             rdfs:label "artefact"@fr ,
                        "artifact"@en ,
                        "object"@en ,
                        "objet"@fr .


###  http://kb.openrobots.org#Avatar
oro:Avatar rdf:type owl:Class ;
           rdfs:subClassOf oro:Agent ;
           rdfs:comment "A disembodied agent, typically represented on a screen as a virtual agent"@en ;
           rdfs:label "avatar"@en ,
                      "avatar"@fr .


###  http://kb.openrobots.org#BodyPart
oro:BodyPart rdf:type owl:Class ;
             rdfs:subClassOf concept:PartiallyTangible ;
             rdfs:label "body part"@en ,
                        "partie du corps"@fr .


###  http://kb.openrobots.org#Book
oro:Book rdf:type owl:Class ;
         rdfs:subClassOf concept:SolidTangibleThing ,
                         [ owl:intersectionOf ( oro:Artifact
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty oro:hasCharacteristicDimension ;
                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                       owl:onDatatype xsd:integer ;
                                                                       owl:withRestrictions ( [ xsd:minInclusive 5
                                                                                              ]
                                                                                              [ xsd:maxInclusive 50
                                                                                              ]
                                                                                            )
                                                                     ]
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty oro:hasCharacteristicWeight ;
                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                       owl:onDatatype xsd:integer ;
                                                                       owl:withRestrictions ( [ xsd:minInclusive 50
                                                                                              ]
                                                                                              [ xsd:maxInclusive 2000
                                                                                              ]
                                                                                            )
                                                                     ]
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty oro:isMovable ;
                                                  owl:hasValue "true"^^xsd:boolean
                                                ]
                                              ) ;
                           rdf:type owl:Class
                         ] ;
         oro:openCycUri "http://sw.opencyc.org/concept/Mx4rwJaXepwpEbGdrcN5Y29ycA" .


###  http://kb.openrobots.org#Bottle
oro:Bottle rdf:type owl:Class ;
           rdfs:subClassOf oro:Container ,
                           oro:Tableware ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty oro:hasShape ;
                             owl:hasValue oro:cylinderShape
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty oro:hasCharacteristicDimension ;
                             owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                 owl:onDatatype xsd:float ;
                                                 owl:withRestrictions ( [ xsd:minInclusive "0.1"^^xsd:float
                                                                        ]
                                                                        [ xsd:maxInclusive "0.3"^^xsd:float
                                                                        ]
                                                                      )
                                               ]
                           ] ;
           rdfs:label "Flasche"@de ,
                      "bottle"@en ,
                      "bouteille"@fr .


###  http://kb.openrobots.org#Box
oro:Box rdf:type owl:Class ;
        rdfs:subClassOf oro:Artifact ,
                        oro:Container ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty oro:hasShape ;
                          owl:hasValue oro:boxShape
                        ] .


###  http://kb.openrobots.org#Cardboardbox
oro:Cardboardbox rdf:type owl:Class ;
                 rdfs:subClassOf oro:Box ,
                                 concept:SolidTangibleThing ;
                 rdfs:label "cardboard box" .


###  http://kb.openrobots.org#Ceilling
oro:Ceilling rdf:type owl:Class ;
             rdfs:subClassOf oro:PhysicalSupport ;
             oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVj3Q5wpEbGdrcN5Y29ycA" ;
             rdfs:label "ceilling"@en ,
                        "plafond"@fr .


###  http://kb.openrobots.org#Cloth
oro:Cloth rdf:type owl:Class ;
          rdfs:subClassOf oro:Artifact ,
                          concept:SolidTangibleThing ;
          rdfs:label "cloth"@en ,
                     "vêtement"@fr .


###  http://kb.openrobots.org#Container
oro:Container rdf:type owl:Class ;
              rdfs:subClassOf concept:PartiallyTangible ;
              oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjOGJwpEbGdrcN5Y29ycA" ;
              rdfs:comment "The collection of tangible objects whose primary function is to contain something."@en ;
              rdfs:label "container"@en ,
                         "contenant"@fr .


###  http://kb.openrobots.org#ContinuousTimeInterval
oro:ContinuousTimeInterval rdf:type owl:Class ;
                           rdfs:subClassOf oro:TimeInterval .


###  http://kb.openrobots.org#Cover
oro:Cover rdf:type owl:Class ;
          rdfs:subClassOf oro:Manipulation ;
          rdfs:label "couvrir"@fr ,
                     "cover"@en .


###  http://kb.openrobots.org#Cup
oro:Cup rdf:type owl:Class ;
        rdfs:subClassOf oro:Tableware ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty oro:hasCharacteristicDimension ;
                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                               owl:onDatatype xsd:integer ;
                                               owl:withRestrictions ( [ xsd:minInclusive 5
                                                                      ]
                                                                      [ xsd:maxInclusive 10
                                                                      ]
                                                                    )
                                             ]
                        ] .


###  http://kb.openrobots.org#EligibleAction
oro:EligibleAction rdf:type owl:Class ;
                   rdfs:subClassOf concept:Action ;
                   rdfs:comment "An instance of EligibleAction is an action whose pre-conditions are currently fullfit, thus could possible be started."@en .


###  http://kb.openrobots.org#EmbodiedAgent
oro:EmbodiedAgent rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( oro:Human
                                                      oro:Robot
                                                    )
                                      ] ;
                  rdfs:subClassOf oro:Agent ;
                  rdfs:label "agent incarné"@fr ,
                             "embodied agent"@en .


###  http://kb.openrobots.org#EmotionalState
oro:EmotionalState rdf:type owl:Class ;
                   rdfs:subClassOf concept:StaticSituation ;
                   rdfs:comment "Describes the emotional state of an agent, like being happy, confused, sad..."@en .


###  http://kb.openrobots.org#EngagementLevel
oro:EngagementLevel rdf:type owl:Class .


###  http://kb.openrobots.org#EngagementSituation
oro:EngagementSituation rdf:type owl:Class ;
                        rdfs:subClassOf concept:StaticSituation ;
                        rdfs:comment """Situation where two or more agents are engaging into joint activity(ies). These activities can by concrete (playing a game together, participating into a phone call,...) or more abstract (eg joint attention).

Importantly, while EngagementSituation is inherently a shared experience between agent, each agent experiences its own, idenpendent, EngagementSituation. As such, only one Agent should experience a given instance of EngagementSituation.

The joint engagement between two (or more) agents is then expressed via the predicate jointEngagementWith, that operates between instances of EngagementSituation."""@en ;
                        rdfs:label "engagement"@en .


###  http://kb.openrobots.org#Eye
oro:Eye rdf:type owl:Class ;
        rdfs:subClassOf oro:BodyPart ;
        rdfs:label "eye"@en ,
                   "œil"@fr .


###  http://kb.openrobots.org#Floor
oro:Floor rdf:type owl:Class ;
          rdfs:subClassOf oro:PhysicalSupport ;
          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVj4k5wpEbGdrcN5Y29ycA" ;
          rdfs:label "floor"@en ,
                     "sol"@fr .


###  http://kb.openrobots.org#GameArtifact
oro:GameArtifact rdf:type owl:Class ;
                 rdfs:subClassOf oro:Artifact ,
                                 concept:SolidTangibleThing ;
                 rdfs:comment "Artifact used to play with. One notable subclass is 'Toy'." .


###  http://kb.openrobots.org#Give
oro:Give rdf:type owl:Class ;
         rdfs:subClassOf oro:Manipulation ;
         rdfs:label "donner"@fr ,
                    "give"@en .


###  http://kb.openrobots.org#Glass
oro:Glass rdf:type owl:Class ;
          rdfs:subClassOf oro:Tableware ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty oro:hasShape ;
                            owl:hasValue oro:cylinderShape
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty oro:hasCharacteristicDimension ;
                            owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                 owl:onDatatype xsd:integer ;
                                                 owl:withRestrictions ( [ xsd:minInclusive 5
                                                                        ]
                                                                        [ xsd:maxInclusive 10
                                                                        ]
                                                                      )
                                               ]
                          ] .


###  http://kb.openrobots.org#GraspableObject
oro:GraspableObject rdf:type owl:Class ;
                    rdfs:subClassOf concept:SolidTangibleThing ;
                    rdfs:label "graspable object"@en ,
                               "objet attrapable"@fr .


###  http://kb.openrobots.org#Greeting
oro:Greeting rdf:type owl:Class ;
             rdfs:subClassOf oro:Interaction .


###  http://kb.openrobots.org#Hand
oro:Hand rdf:type owl:Class ;
         owl:equivalentClass concept:Hand ;
         rdfs:subClassOf oro:BodyPart .


###  http://kb.openrobots.org#Head
oro:Head rdf:type owl:Class ;
         rdfs:subClassOf oro:BodyPart ;
         rdfs:label "head"@en ,
                    "tête"@fr .


###  http://kb.openrobots.org#Human
oro:Human rdf:type owl:Class ;
          rdfs:subClassOf oro:EmbodiedAgent ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty oro:hasCharacteristicDimension ;
                            owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                 owl:onDatatype xsd:integer ;
                                                 owl:withRestrictions ( [ xsd:minInclusive 140
                                                                        ]
                                                                        [ xsd:maxInclusive 200
                                                                        ]
                                                                      )
                                               ]
                          ] ;
          owl:disjointWith oro:Robot ;
          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvViAkpwpEbGdrcN5Y29ycA" ;
          rdfs:label "humain"@fr ,
                     "human"@en .


###  http://kb.openrobots.org#Idling
oro:Idling rdf:type owl:Class ;
           rdfs:subClassOf concept:Resting-Relaxing ;
           rdfs:comment "A type of Resting-Relaxing action where the agent is 'doing nothing'."@en .


###  http://kb.openrobots.org#Interaction
oro:Interaction rdf:type owl:Class ;
                rdfs:subClassOf concept:Action ;
                rdfs:comment "An action that involves some sort of interaction between two (or more) agents."@en .


###  http://kb.openrobots.org#Jacket
oro:Jacket rdf:type owl:Class ;
           rdfs:subClassOf oro:Cloth ;
           rdfs:label "jacket"@en ,
                      "veste"@fr .


###  http://kb.openrobots.org#JointAttentionSituation
oro:JointAttentionSituation rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( concept:Situation
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty oro:involves ;
                                                                         owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty oro:isFocusOf ;
                                                                                              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                                              owl:onClass oro:Agent
                                                                                            ]
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf concept:StaticSituation ;
                            rdfs:comment "A joint attention situation is a situation where an object is the focus of attention of more than one agent." .


###  http://kb.openrobots.org#LeftHand
oro:LeftHand rdf:type owl:Class ;
             rdfs:subClassOf concept:Hand ;
             owl:disjointWith oro:RightHand .


###  http://kb.openrobots.org#Location
oro:Location rdf:type owl:Class ;
             owl:equivalentClass concept:SpatialThing-Localized ;
             rdfs:comment "Location is use in its very broad meaning of \"a spatial-localized thing\". Hence an object is a location, an agent is a location, etc." .


###  http://kb.openrobots.org#Manipulation
oro:Manipulation rdf:type owl:Class ;
                 rdfs:subClassOf concept:Action ;
                 owl:disjointWith oro:Navigation ;
                 rdfs:label "manipulation"@en ,
                            "manipulation"@fr .


###  http://kb.openrobots.org#Navigation
oro:Navigation rdf:type owl:Class ;
               rdfs:subClassOf concept:Action ;
               rdfs:comment "A navigation action is an action where the robot moves from one location to the other, usually relying on a pre-computed navigation plan, and adjusting en route to unexpected obstacles."@en .


###  http://kb.openrobots.org#NonAlcoholicBeverage
oro:NonAlcoholicBeverage rdf:type owl:Class ;
                         rdfs:subClassOf concept:Drink ;
                         owl:disjointWith concept:AlcoholicBeverage .


###  http://kb.openrobots.org#Obstacle
oro:Obstacle rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( concept:EnduringThing-Localized
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty oro:isTraversable ;
                                                          owl:hasValue "false"^^xsd:boolean
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             owl:disjointWith oro:Opening ;
             oro:openCycUri "http://sw.opencyc.org/concept/Mx4rwJJMaZwpEbGdrcN5Y29ycA" ;
             rdfs:label "obstacle"@en ,
                        "obstacle"@fr .


###  http://kb.openrobots.org#Opening
oro:Opening rdf:type owl:Class ;
            rdfs:subClassOf concept:EnduringThing-Localized ;
            rdfs:label "opening"@en ,
                       "ouverture"@fr .


###  http://kb.openrobots.org#PhysicalSupport
oro:PhysicalSupport rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( concept:PartiallyTangible
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty oro:isHolder ;
                                                                 owl:hasValue "true"^^xsd:boolean
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf oro:Place ;
                    rdfs:comment "A PhysicalSupport is a special kind of tangible object which main feature is to hold other tangible objects. It includes walls, floors, tables, shelves..." ;
                    rdfs:label "physical support"@en ,
                               "support physique"@fr .


###  http://kb.openrobots.org#Pick
oro:Pick rdf:type owl:Class ;
         rdfs:subClassOf oro:Manipulation ;
         rdfs:label "pick"@en ,
                    "prendre"@fr .


###  http://kb.openrobots.org#Place
oro:Place rdf:type owl:Class ;
          rdfs:subClassOf concept:EnduringThing-Localized ;
          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjTtJwpEbGdrcN5Y29ycA" ;
          rdfs:comment "A specialization of EnduringThing_Localized (q.v). Each instance of Place is a spatial thing which has a relatively permanent location." ;
          rdfs:label "endroit"@fr ,
                     "place"@en .


###  http://kb.openrobots.org#Placemat
oro:Placemat rdf:type owl:Class ;
             rdfs:subClassOf oro:Tableware ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty oro:isHolder ;
                               owl:hasValue "true"^^xsd:boolean
                             ] .


###  http://kb.openrobots.org#Point
oro:Point rdf:type owl:Class ;
          rdfs:subClassOf concept:SpaceRegion ;
          oro:openCycUri "http://sw.opencyc.org/2008/06/10/concept/Mx4rwH1QOJwpEbGdrcN5Y29ycA" ;
          rdfs:comment """A specialization of both Point and SpaceRegion_Empirical (qq.v.). Each instance of Point_Empirical is a zero-dimensional object that belongs to, and thus has a fixed location in, the embedding space of the empirical universe (see #$TheSpatialUniverse-Empirical).

Examples include the location of the center of mass of the Milky Way galaxy at the beginning of the 20th Century. Note that empirical space points are embedded in time; if time is not a significant parameter (i.e. if in an atemporal or temporally agnostic context) consider using Point instead.""" ,
                       "For ease of use, we use here \"Point\" as \"Point-Empirical\" in the Open Cyc ontology. The OpenCyc URI refers to the correct one (\"Point-Empirical\")" ;
          rdfs:label "point"@en ,
                     "point"@fr .


###  http://kb.openrobots.org#Posture
oro:Posture rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( oro:sitting
                                              oro:standing
                                            )
                                ] ;
            rdfs:subClassOf concept:SpatialThing ;
            rdfs:label "posture"@en ,
                       "posture"@fr .


###  http://kb.openrobots.org#Put
oro:Put rdf:type owl:Class ;
        rdfs:subClassOf oro:Manipulation ;
        rdfs:label "poser"@fr ,
                   "put"@en .


###  http://kb.openrobots.org#Release
oro:Release rdf:type owl:Class ;
            rdfs:subClassOf oro:Manipulation ;
            rdfs:label "lâcher"@fr ,
                       "release"@en .


###  http://kb.openrobots.org#Remote
oro:Remote rdf:type owl:Class ;
           rdfs:subClassOf oro:Artifact ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty oro:hasShape ;
                             owl:hasValue oro:boxShape
                           ] .


###  http://kb.openrobots.org#Rest
oro:Rest rdf:type owl:Class ;
         owl:equivalentClass concept:Resting-Relaxing ;
         rdfs:subClassOf concept:Action ;
         rdfs:comment "" .


###  http://kb.openrobots.org#RightHand
oro:RightHand rdf:type owl:Class ;
              rdfs:subClassOf concept:Hand .


###  http://kb.openrobots.org#Robot
oro:Robot rdf:type owl:Class ;
          rdfs:subClassOf oro:EmbodiedAgent ;
          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rwQr1pJwpEbGdrcN5Y29ycA" ;
          rdfs:label "robot"@en ,
                     "robot"@fr .


###  http://kb.openrobots.org#Shape
oro:Shape rdf:type owl:Class ;
          rdfs:subClassOf concept:SpatialThing ;
          rdfs:label "forme"@fr ,
                     "shape"@en .


###  http://kb.openrobots.org#Shelf
oro:Shelf rdf:type owl:Class ;
          rdfs:subClassOf concept:Object-SupportingFurniture ;
          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjY_5wpEbGdrcN5Y29ycA" ;
          rdfs:label "shelf"@en ,
                     "étagère"@fr .


###  http://kb.openrobots.org#Situation
oro:Situation rdf:type owl:Class ;
              owl:equivalentClass concept:Situation .


###  http://kb.openrobots.org#Size
oro:Size rdf:type owl:Class ;
         rdfs:subClassOf concept:SpatialThing ;
         rdfs:comment "A symbolic size like large or small has NO absolute meaning. It is always relative to a context."@en .


###  http://kb.openrobots.org#SpaceChunk
oro:SpaceChunk rdf:type owl:Class ;
               owl:equivalentClass oro:Zone ;
               rdfs:subClassOf concept:SpaceRegion ;
               rdfs:comment "A three-dimensional space region that can be occupied by solid objects."@en .


###  http://kb.openrobots.org#StorageBox
oro:StorageBox rdf:type owl:Class ;
               rdfs:subClassOf oro:Box .


###  http://kb.openrobots.org#Tableware
oro:Tableware rdf:type owl:Class ;
              rdfs:subClassOf oro:Artifact ,
                              concept:SolidTangibleThing ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty oro:isMovable ;
                                owl:hasValue "true"^^xsd:boolean
                              ] .


###  http://kb.openrobots.org#Task
oro:Task rdf:type owl:Class ;
         rdfs:subClassOf concept:PurposefulAction ;
         rdfs:comment "An action considered in the specific context of robotics." ;
         rdfs:label "task"@en ,
                    "tâche"@fr .


###  http://kb.openrobots.org#TaskPlan
oro:TaskPlan rdf:type owl:Class ;
             rdfs:subClassOf concept:Plan-ExpectedSituationType ;
             rdfs:comment "Sequence of actions"@en ;
             rdfs:label "plan"@en ,
                        "plan"@fr .


###  http://kb.openrobots.org#TimeInterval
oro:TimeInterval rdf:type owl:Class ;
                 rdfs:subClassOf concept:Plan-ExpectedSituationType ;
                 rdfs:label "intervalle de temps"@fr ,
                            "time interval"@en .


###  http://kb.openrobots.org#TimePoint
oro:TimePoint rdf:type owl:Class ;
              rdfs:subClassOf oro:ContinuousTimeInterval ;
              rdfs:label "time point" .


###  http://kb.openrobots.org#Toolbox
oro:Toolbox rdf:type owl:Class ;
            rdfs:subClassOf oro:Box ,
                            concept:SolidTangibleThing ;
            rdfs:comment "A specialization of box used to carry tools." .


###  http://kb.openrobots.org#Torso
oro:Torso rdf:type owl:Class ;
          rdfs:subClassOf oro:BodyPart ;
          rdfs:label "torse"@fr ,
                     "torso"@en .


###  http://kb.openrobots.org#Toy
oro:Toy rdf:type owl:Class ;
        rdfs:subClassOf oro:GameArtifact ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty oro:isMovable ;
                          owl:hasValue "true"^^xsd:boolean
                        ] .


###  http://kb.openrobots.org#ToyCube
oro:ToyCube rdf:type owl:Class ;
            rdfs:subClassOf oro:Toy ;
            rdfs:comment "A cube, traditionnaly made of wood, meant for children to play with." .


###  http://kb.openrobots.org#Trashbin
oro:Trashbin rdf:type owl:Class ;
             rdfs:subClassOf oro:Artifact ,
                             concept:SolidTangibleThing ;
             oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjUTpwpEbGdrcN5Y29ycA" ;
             rdfs:label "poubelle"@fr ,
                        "trashbin"@en .


###  http://kb.openrobots.org#Uncover
oro:Uncover rdf:type owl:Class ;
            rdfs:subClassOf oro:Manipulation ;
            rdfs:label "découvrir"@fr ,
                       "uncover"@en .


###  http://kb.openrobots.org#VisualMark
oro:VisualMark rdf:type owl:Class ;
               rdfs:subClassOf concept:PartiallyTangible ;
               oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVkLmJwpEbGdrcN5Y29ycA" ;
               rdfs:label "marker"@en ,
                          "marqueur visuel"@fr ,
                          "visual mark"@en .


###  http://kb.openrobots.org#Wall
oro:Wall rdf:type owl:Class ;
         rdfs:subClassOf oro:PhysicalSupport ;
         oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjfapwpEbGdrcN5Y29ycA" ;
         rdfs:label "mur"@fr ,
                    "wall"@en .


###  http://kb.openrobots.org#Window
oro:Window rdf:type owl:Class ;
           rdfs:subClassOf oro:Artifact ,
                           concept:SolidTangibleThing ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty oro:isTraversable ;
                             owl:hasValue "true"^^xsd:boolean
                           ] ;
           oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVj5V5wpEbGdrcN5Y29ycA" .


###  http://kb.openrobots.org#Zone
oro:Zone rdf:type owl:Class ;
         rdfs:subClassOf concept:SpaceRegion .


###  http://kb.openrobots.org#ZoneOfAction
oro:ZoneOfAction rdf:type owl:Class ;
                 rdfs:subClassOf oro:SpaceChunk ;
                 rdfs:comment "Defines the portion of space in which an agent can act. It primary relates to actions like taking something." .


###  http://kb.openrobots.org#ZoneOfInteraction
oro:ZoneOfInteraction rdf:type owl:Class ;
                      rdfs:subClassOf oro:SpaceChunk .


###  http://kb.openrobots.org#ZoneOfInterest
oro:ZoneOfInterest rdf:type owl:Class ;
                   rdfs:subClassOf oro:SpaceChunk ;
                   rdfs:comment """A specific region of space which has an interest for some purpose.
For instance, a table can have several zone of interests describing parts of the table interessant for the robot (plates, zons in front of chairs,etc.)""" ;
                   rdfs:label "zone d'intérêt"@fr ,
                              "zone of interest"@en .


###  http://sw.opencyc.org/concept/Action
concept:Action rdf:type owl:Class ;
               rdfs:subClassOf concept:Event ;
               oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVioQZwpEbGdrcN5Y29ycA" ;
               rdfs:comment """An action implies several thematic roles (or semantic roles):

We use this list of roles (Aarts 1997: 88), which are mapped to specific predicates :
Agent: The ‘doer’ or instigator of the action denoted by the predicate.
Patient: The ‘undergoer’ of the action or event denoted by the predicate.
Theme: The entity that is moved by the action or event denoted by the predicate.
Experiencer: The living entity that experiences the action or event denoted by the predicate.
Goal: The location or entity in the direction of which something moves.
Benefactive: The entity that benefits from the action or event denoted by the predicate.
Source: The location or entity from which something moves
Instrument: The medium by which the action or event denoted by the predicate is carried out.
Locative: The specification of the place where the action or event denoted by the predicate in situated.""" ,
                            """The collection of Events (q.v.) that are carried out by some \"doer\". Instances of Action include any event in which one or more agents effect some change in the (tangible or intangible) state of the world, typically by an expenditure of effort or energy. Note that it is not required that any tangible object be moved, changed, produced, or destroyed for an action to occur; the effects of an action might be intangible. In the context of the OpenRobotOntology, doers of an action are as a matter of fact instances to Agent_PartiallyTangible (q.v.), even if they may not be in a broader context (e.g. a falling rock that dents a car's roof). Depending upon the context, doers of actions might be animate or inanimate, conscious or nonconscious. For actions that are intentional, see PurposefulAction and performedBy.

The object of an action is asserted through the properties objectOfAction and recipientOfAction.""" ;
               rdfs:label "action"@en ,
                          "action"@fr .


###  http://sw.opencyc.org/concept/AlcoholicBeverage
concept:AlcoholicBeverage rdf:type owl:Class ;
                          rdfs:subClassOf concept:Drink .


###  http://sw.opencyc.org/concept/AppleJuice
concept:AppleJuice rdf:type owl:Class ;
                   rdfs:subClassOf oro:NonAlcoholicBeverage ;
                   owl:disjointWith concept:OrangeJuice ;
                   rdfs:label "apple juice"@en ,
                              "jus de pomme"@fr .


###  http://sw.opencyc.org/concept/ArmChair
concept:ArmChair rdf:type owl:Class ;
                 rdfs:subClassOf concept:FurniturePiece ;
                 rdfs:label "armchair"@en ,
                            "fauteuil"@fr .


###  http://sw.opencyc.org/concept/Beer
concept:Beer rdf:type owl:Class ;
             rdfs:subClassOf concept:AlcoholicBeverage ;
             owl:disjointWith concept:Wine ;
             rdfs:label "beer"@en .


###  http://sw.opencyc.org/concept/Can
concept:Can rdf:type owl:Class ;
            rdfs:subClassOf oro:Artifact ,
                            oro:Container ,
                            concept:SolidTangibleThing ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty oro:hasShape ;
                              owl:hasValue oro:cylinderShape
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty oro:hasCharacteristicDimension ;
                              owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                  owl:onDatatype xsd:float ;
                                                  owl:withRestrictions ( [ xsd:minInclusive "0.05"^^xsd:float
                                                                         ]
                                                                         [ xsd:maxInclusive "0.12"^^xsd:float
                                                                         ]
                                                                       )
                                                ]
                            ] ;
            oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVj-85wpEbGdrcN5Y29ycA" ;
            rdfs:label "Dose"@de ,
                       "can"@en ,
                       "cannette"@fr .


###  http://sw.opencyc.org/concept/CellularTelephone
concept:CellularTelephone rdf:type owl:Class ;
                          rdfs:subClassOf oro:Artifact ,
                                          concept:SolidTangibleThing ;
                          rdfs:label "mobile phone"@en ,
                                     "téléphone mobile"@fr .


###  http://sw.opencyc.org/concept/Chair-PieceOfFurniture
concept:Chair-PieceOfFurniture rdf:type owl:Class ;
                               rdfs:subClassOf concept:FurniturePiece ;
                               rdfs:label "chair"@en ,
                                          "chaise"@fr .


###  http://sw.opencyc.org/concept/Color
concept:Color rdf:type owl:Class ;
              rdfs:subClassOf owl:Thing ;
              oro:openCycUri "http://sw.opencyc.org/concept/Mx4rr19QJHStEdaAAACgyZzFrg" ;
              rdfs:label "colour"@en ,
                         "couleur"@fr .


###  http://sw.opencyc.org/concept/Drink
concept:Drink rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:unionOf ( oro:NonAlcoholicBeverage
                                                  concept:AlcoholicBeverage
                                                )
                                  ] ;
              rdfs:subClassOf concept:FoodOrDrink ,
                              concept:LiquidTangibleThing ;
              owl:disjointWith concept:Food ;
              rdfs:label "beverage"@en ,
                         "boisson"@fr ,
                         "drink"@en .


###  http://sw.opencyc.org/concept/EdibleStuff
concept:EdibleStuff rdf:type owl:Class ;
                    rdfs:subClassOf concept:PartiallyTangible .


###  http://sw.opencyc.org/concept/EnduringThing-Localized
concept:EnduringThing-Localized rdf:type owl:Class ;
                                rdfs:subClassOf concept:SpatialThing-Localized ;
                                oro:openCycUri "http://sw.opencyc.org/concept/Mx4ro3lluGJHQdiVxrZReHS-jQ" ;
                                rdfs:comment "A specialization of both SpatialThing_Localized and SomethingExisting (qq.v.). Each instance of EnduringThing_Localized is a spatial enduring thing at which an event can occur or a situation can obtain. Positive examples include planets, the borders between countries, human beings, rocks, and atoms. Negative example include situations, events, abstract objects, and regions of space that exclusively act as possible locations for other spatial objects (see SpaceRegion). An important specialization of EnduringThing_Localized is Place (q.v.). The salient distinction between places (instances of Place) and locations (instances of EnduringThing_Localized) is that places are assumed to have relatively permanent locations, whereas locations need not have permanent locations. Thus, from the perspective of someone standing on a beach, the crest of a breaking wave can be a location at which foaming is occuring (thus an EnduringThing_Localized), but it cannot be such a place (i.e. it cannot be an instance of Place)." ;
                                rdfs:label "lieu physique"@fr ,
                                           "spatial enduring thing"@en .


###  http://sw.opencyc.org/concept/Event
concept:Event rdf:type owl:Class ;
              rdfs:subClassOf concept:Situation ;
              owl:disjointWith concept:StaticSituation ;
              oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvViADZwpEbGdrcN5Y29ycA" ;
              rdfs:label "event"@en ,
                         "évènement"@fr .


###  http://sw.opencyc.org/concept/FluidTangibleThing
concept:FluidTangibleThing rdf:type owl:Class ;
                           rdfs:subClassOf concept:PartiallyTangible ;
                           owl:disjointWith concept:SolidTangibleThing ;
                           rdfs:label "fluid"@en ,
                                      "fluide"@fr .


###  http://sw.opencyc.org/concept/Food
concept:Food rdf:type owl:Class ;
             rdfs:subClassOf concept:FoodOrDrink .


###  http://sw.opencyc.org/concept/FoodOrDrink
concept:FoodOrDrink rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:unionOf ( concept:Drink
                                                        concept:Food
                                                      )
                                        ] ;
                    rdfs:subClassOf concept:EdibleStuff ;
                    rdfs:comment "A specialization of EdibleStuff (q.v.). Each instance of FoodOrDrink is a substance which instances of some type of organism (that is, some sub-collection of Organism_Whole) normally consume a significant part of. Important specializations of FoodOrDrink include Food (instances of which require chewing in order to be consumed) and Drink (instances of which are liquids that can be consumed without chewing)."@en .


###  http://sw.opencyc.org/concept/FurniturePiece
concept:FurniturePiece rdf:type owl:Class ;
                       rdfs:subClassOf oro:Artifact ,
                                       concept:SolidTangibleThing ;
                       rdfs:label "furniture"@en ,
                                  "meuble"@fr .


###  http://sw.opencyc.org/concept/Hand
concept:Hand rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:unionOf ( oro:LeftHand
                                                 oro:RightHand
                                               )
                                 ] ;
             rdfs:subClassOf oro:BodyPart ;
             rdfs:label "hand"@en ,
                        "main"@fr .


###  http://sw.opencyc.org/concept/LiquidTangibleThing
concept:LiquidTangibleThing rdf:type owl:Class ;
                            rdfs:subClassOf concept:FluidTangibleThing ;
                            rdfs:label "liquid"@en ,
                                       "liquide"@fr .


###  http://sw.opencyc.org/concept/Object-SupportingFurniture
concept:Object-SupportingFurniture rdf:type owl:Class ;
                                   owl:equivalentClass [ owl:intersectionOf ( concept:FurniturePiece
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty oro:isHolder ;
                                                                                owl:hasValue "true"^^xsd:boolean
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ;
                                   rdfs:label "support"@en ,
                                              "support"@fr .


###  http://sw.opencyc.org/concept/OrangeJuice
concept:OrangeJuice rdf:type owl:Class ;
                    rdfs:subClassOf oro:NonAlcoholicBeverage ;
                    rdfs:label "jus d'orange"@fr ,
                               "orange juice"@en .


###  http://sw.opencyc.org/concept/PartiallyTangible
concept:PartiallyTangible rdf:type owl:Class ;
                          rdfs:subClassOf concept:EnduringThing-Localized ;
                          oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVj27ZwpEbGdrcN5Y29ycA" ;
                          rdfs:comment "A subcollection of EnduringThing_Localized and TemporalThing. Each instance of PartiallyTangible has a tangible (i.e. material) part and a temporal extent (i.e. it exists in time). It might or might not also have an intangible part. For example, a particular copy of a book is made of matter, has temporal extent, and also has an intangible part: the information content of the text markings on its pages." ;
                          rdfs:label "tangible thing"@en .


###  http://sw.opencyc.org/concept/Plan-ExpectedSituationType
concept:Plan-ExpectedSituationType rdf:type owl:Class ;
                                   rdfs:subClassOf concept:TemporalThing ;
                                   rdfs:label "thing with a temporal extend"@en .


###  http://sw.opencyc.org/concept/Plant
concept:Plant rdf:type owl:Class ;
              rdfs:subClassOf concept:PartiallyTangible ;
              rdfs:label "plant"@en ,
                         "plante"@fr .


###  http://sw.opencyc.org/concept/PurposefulAction
concept:PurposefulAction rdf:type owl:Class ;
                         rdfs:subClassOf concept:Action ;
                         oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVieP5wpEbGdrcN5Y29ycA" ;
                         rdfs:comment "A specialization of both Action and AtLeastPartiallyMentalEvent. Each instance of PurposefulAction is an action consciously, volitionally, and purposefully done by (see performedBy) at least one actor." ;
                         rdfs:label "action volontaire"@fr ,
                                    "purposeful action"@en .


###  http://sw.opencyc.org/concept/Resting-Relaxing
concept:Resting-Relaxing rdf:type owl:Class ;
                         rdfs:subClassOf concept:Action ;
                         rdfs:comment "The collection of events in which an animal abstains from strenuous physical activity." ;
                         rdfs:label "repos"@fr ,
                                    "rest"@en .


###  http://sw.opencyc.org/concept/Situation
concept:Situation rdf:type owl:Class ;
                  rdfs:subClassOf concept:Plan-ExpectedSituationType ;
                  oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvYjIS5wpEbGdrcN5Y29ycA" ;
                  rdfs:comment "Each instance of Situation is a state or event consisting of one or more objects having certain properties or bearing certain relations to each other. Notable specializations of Situation are Event and StaticSituation; it is disjoint with SomethingExisting." ;
                  rdfs:label "situation"@en ,
                             "situation"@fr .


###  http://sw.opencyc.org/concept/Sofa-PieceOfFurniture
concept:Sofa-PieceOfFurniture rdf:type owl:Class ;
                              rdfs:subClassOf concept:FurniturePiece ;
                              rdfs:label "canapé"@fr ,
                                         "couch"@en ,
                                         "sofa"@en .


###  http://sw.opencyc.org/concept/SoftDrink
concept:SoftDrink rdf:type owl:Class ;
                  rdfs:subClassOf oro:NonAlcoholicBeverage ;
                  rdfs:label "soda"@en ,
                             "soft drink"@en .


###  http://sw.opencyc.org/concept/SolidTangibleThing
concept:SolidTangibleThing rdf:type owl:Class ;
                           rdfs:subClassOf concept:PartiallyTangible ;
                           rdfs:label "solid thing"@en .


###  http://sw.opencyc.org/concept/SpaceRegion
concept:SpaceRegion rdf:type owl:Class ;
                    rdfs:subClassOf concept:SpatialThing-Localized ;
                    oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvlxdi5wpEbGdrcN5Y29ycA" ;
                    rdfs:comment """A specialization of both SpatialThing and IntangibleIndividual (qq.v.) whose instances are regions of space that exclusively act as possible locations for other spatial objects, and thus are immobile. A space region might be three-, two-, one-, or zero-dimensional; and spatial objects \"occupy\" such regions accordingly. Three-dimensional space regions (see SpaceChunk) can be occupied by solid objects. Two-dimensional space regions (or Surfaces) can be occupied by a purely two-dimensional objects. And similarly for one-dimensional space regions (Lines) and zero-dimensional space regions (Points).

Another important specialization of SpaceRegion is SpaceRegion_Empirical, whose instances are pieces of the embedding space for spatio-temporal objects (see SpatialThing_Localized).

For more on spatial location and occupancy, see AbsoluteLocationalPredicate and its instances.""" ;
                    rdfs:label "zone"@en ,
                               "zone"@fr .


###  http://sw.opencyc.org/concept/SpatialThing
concept:SpatialThing rdf:type owl:Class ;
                     rdfs:subClassOf owl:Thing ;
                     oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvVjpUZwpEbGdrcN5Y29ycA" ;
                     rdfs:comment "A specialization of Individual. The collection of all things that have a spatial extent or location relative to some other SpatialThing or in some embedding space. Note that to say that an entity is a member of this collection is to remain agnostic about two issues. First, a SpatialThing may be PartiallyTangible (e.g. Texas-State) or wholly Intangible (e.g. ArcticCircle or a line mentioned in a geometric theorem). Second, although we do insist on location relative to another spatial thing or in some embedding space, a SpatialThing might or might not be located in the actual physical universe. It is far from clear that all SpatialThings are so located: an ideal platonic circle or a trajectory through the phase space of some physical system (e.g.) might not be. If the intent is to imply location in the empirically observable cosmos, the user should employ this collection's specialization, SpatialThing-Localized." ;
                     rdfs:label "chose spatiale"@fr ,
                                "spatial thing"@en .


###  http://sw.opencyc.org/concept/SpatialThing-Localized
concept:SpatialThing-Localized rdf:type owl:Class ;
                               rdfs:subClassOf concept:SpatialThing ;
                               oro:openCycUri "http://sw.opencyc.org/concept/Mx4rwS68M5wpEbGdrcN5Y29ycA" ;
                               rdfs:comment """A specialization of both SpatialThing and TemporalThing. This is the collection of all spatial things, tangible or intangible, that can meaningfully be said to have location or position in the empirical universe.

Examples of spatially-localized things include all PartiallyTangible things, such as trees and ships, as well as certain Intangible spatial things, like the EarthsEquator. Also included are those events that can be pinned-down to specific places (see Event-Localized), and thus all PhysicalEvents. Excluded from this collection are any SpatialThings that are not localized, such as -- arguably -- purely abstract geometrical figures (e.g. a Platonic sphere).

Note that a fictional or imaginary object (such as Frodo, Captain Queeg, or HAL9000-TheComputer) is typically localized with respect to the universe of the fictional/imagnary context in which it is found, and so is an instance of SpatialThing-Localized with respect to that context.""" ;
                               rdfs:label "lieu"@fr ,
                                          "location"@en .


###  http://sw.opencyc.org/concept/StaticSituation
concept:StaticSituation rdf:type owl:Class ;
                        rdfs:subClassOf concept:Situation ;
                        oro:openCycUri "http://sw.opencyc.org/concept/Mx4rvh5TfJwpEbGdrcN5Y29ycA" ;
                        rdfs:comment "A specialization of Situation. Each instance of StaticSituation is a state of affairs between two or more things, persisting statically over some time interval. IE, a state of the world." ;
                        rdfs:label "situation statique"@fr ,
                                   "static situation"@en .


###  http://sw.opencyc.org/concept/Table-PieceOfFurniture
concept:Table-PieceOfFurniture rdf:type owl:Class ;
                               rdfs:subClassOf concept:Object-SupportingFurniture ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty oro:hasCharacteristicDimension ;
                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                      owl:onDatatype xsd:integer ;
                                                                      owl:withRestrictions ( [ xsd:minInclusive 50
                                                                                             ]
                                                                                             [ xsd:maxInclusive 300
                                                                                             ]
                                                                                           )
                                                                    ]
                                               ] ;
                               rdfs:label "table"@en ,
                                          "table"@fr .


###  http://sw.opencyc.org/concept/TemporalThing
concept:TemporalThing rdf:type owl:Class ;
                      rdfs:subClassOf owl:Thing ;
                      rdfs:label "chose temporelle"@fr ,
                                 "temporal thing"@en .


###  http://sw.opencyc.org/concept/Tray
concept:Tray rdf:type owl:Class ;
             rdfs:subClassOf oro:Artifact ,
                             oro:Container ;
             rdfs:label "plateau"@fr ,
                        "tray"@en .


###  http://sw.opencyc.org/concept/Wine
concept:Wine rdf:type owl:Class ;
             rdfs:subClassOf concept:AlcoholicBeverage ;
             rdfs:label "wine"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class ;
          rdfs:label "chose"@fr ,
                     "thing"@en .


